# What the accuracy benchmark runs. Changing this file starts a new run.
SUBSET=benchmark-datasets/dev_set/240825.1_dev1
LIMIT=0
# Head count known (upper bound, exact), every fixed count from 2 to 10, and a sweep of the
# grouping weights. All of these reuse one voice analysis per meeting, so they are cheap.
VARIANTS="--voices \
 --variant max:speakers=ref --variant exact:speakers=ref,exact=true \
 --variant k2:speakers=2,exact=true --variant k3:speakers=3,exact=true --variant k4:speakers=4,exact=true \
 --variant k5:speakers=5,exact=true --variant k6:speakers=6,exact=true --variant k7:speakers=7,exact=true \
 --variant k8:speakers=8,exact=true --variant k9:speakers=9,exact=true --variant k10:speakers=10,exact=true \
 --variant fa15:fa=0.15 --variant fa30:fa=0.3 --variant fa50:fa=0.5 --variant fb4:fb=4 --variant fb16:fb=16 \
 --variant fa15fb4:fa=0.15,fb=4 --variant fa30fb4:fa=0.3,fb=4 --variant fa30fb16:fa=0.3,fb=16 --variant fa50fb16:fa=0.5,fb=16 \
 --variant t40:threshold=0.4 --variant t50:threshold=0.5 --variant t70:threshold=0.7 --variant t80:threshold=0.8 \
 --variant t50fa30:threshold=0.5,fa=0.3 --variant t70fa30:threshold=0.7,fa=0.3 \
 --variant free:apart=false --variant ms1:minseg=1.0 --variant ov:overlap=true"
