# What the accuracy benchmark runs. Changing this file starts a new run.
# The evaluation meetings: none of the settings were chosen on these.
SUBSET=benchmark-datasets/eval_set/240825.1_eval_full_with_GT
LIMIT=0
# "stock" leaves the speaker count to the separation library; "exact" is told the true number of
# speakers; "eend" (from --eend) is a different kind of speaker-separation model, for comparison.
VARIANTS="--eend --variant stock:count=false --variant exact:speakers=ref,exact=true"
