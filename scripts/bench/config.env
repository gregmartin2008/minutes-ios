# What the accuracy benchmark runs. Changing this file starts a new run.
# The evaluation meetings: none of the settings were chosen on these.
SUBSET=benchmark-datasets/eval_set/240825.1_eval_full_with_GT
LIMIT=0
# "stock" leaves the speaker count to the separation library; "max" and "exact" are given the true
# number of speakers as an upper bound and as the exact count; the rest vary the counting step.
VARIANTS="--variant stock:count=false --variant max:speakers=ref --variant exact:speakers=ref,exact=true \
 --variant cd100:cd=1.0 --variant cd110:cd=1.1 --variant cs3:cs=0.03 --variant cs5:cs=0.05"
