# What the accuracy benchmark runs. Changing this file starts a new run.
# The evaluation meetings. The settings were chosen on the separate development meetings.
SUBSET=benchmark-datasets/eval_set/240825.1_eval_full_with_GT
LIMIT=0
# "stock" leaves the speaker count to the separation library; "exact" is told the true number.
VARIANTS="--variant stock:count=false --variant exact:speakers=ref,exact=true"
# rerun 22:58:38
