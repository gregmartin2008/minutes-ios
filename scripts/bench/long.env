# Full-length meetings for the accuracy benchmark. Changing this file starts a new run.
# ICSI: research-group meetings with seven to ten speakers, most about an hour (headset mix).
ICSI=Bed016,Bmr012,Buw001,Bmr019,Bmr024,Bmr005,Bmr010,Bro003,Bed010
# AMI: the standard 16-meeting test set, four speakers, one far-field table microphone.
AMI=ES2004a,ES2004b,ES2004c,ES2004d,IS1009a,IS1009b,IS1009c,IS1009d,EN2002a,EN2002b,EN2002c,EN2002d,TS3003a,TS3003b,TS3003c,TS3003d
# "stock" leaves the speaker count to the separation library; "max" and "exact" are given the true
# number of speakers as an upper bound and as the exact count; the rest vary the counting step.
VARIANTS="--voices --variant stock:count=false --variant max:speakers=ref --variant exact:speakers=ref,exact=true \
 --variant cd100:cd=1.0 --variant cs2:cs=0.02 --variant cs3:cs=0.03"
