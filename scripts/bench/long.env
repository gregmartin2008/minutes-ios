# Full-length meetings for the accuracy benchmark. Changing this file starts a new run.
# ICSI: research-group meetings with six to nine speakers, most about an hour (headset mix).
ICSI=Bed016,Bmr012,Buw001,Bmr019,Bmr024,Bmr005,Bmr010,Bro003,Bed010
# AMI: the standard 16-meeting test set, four speakers, one far-field table microphone.
AMI=ES2004a,ES2004b,ES2004c,ES2004d,IS1009a,IS1009b,IS1009c,IS1009d,EN2002a,EN2002b,EN2002c,EN2002d,TS3003a,TS3003b,TS3003c,TS3003d
# This run: only the first 6, 12 and 20 minutes of each meeting, to see how the length of a
# recording changes which way of counting the speakers works better.
FETCH_OPTIONS="--clips 360,720,1200 --no-full"
# "stock" leaves the speaker count to the separation library; "exact" is given the true number.
VARIANTS="--variant stock:count=false --variant exact:speakers=ref,exact=true"
