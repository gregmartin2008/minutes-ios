# Full-length meetings for the accuracy benchmark. Changing this file starts a new run.
# ICSI: research-group meetings with seven to ten speakers, most about an hour (headset mix).
ICSI=Bed016,Bmr012,Buw001,Bmr019,Bmr024,Bmr005,Bmr010,Bro003,Bed010
# AMI: the standard 16-meeting test set, four speakers, one far-field table microphone.
AMI=ES2004a,ES2004b,ES2004c,ES2004d,IS1009a,IS1009b,IS1009c,IS1009d,EN2002a,EN2002b,EN2002c,EN2002d,TS3003a,TS3003b,TS3003c,TS3003d
VARIANTS="--voices --variant max:speakers=ref --variant exact:speakers=ref,exact=true \
 --variant k2:speakers=2,exact=true --variant k3:speakers=3,exact=true --variant k4:speakers=4,exact=true \
 --variant k5:speakers=5,exact=true --variant k6:speakers=6,exact=true --variant k7:speakers=7,exact=true \
 --variant k8:speakers=8,exact=true --variant k9:speakers=9,exact=true --variant k10:speakers=10,exact=true \
 --variant k11:speakers=11,exact=true --variant k12:speakers=12,exact=true \
 --variant t70:threshold=0.7 --variant t80:threshold=0.8 --variant fa30:fa=0.3 --variant fb4:fb=4"
